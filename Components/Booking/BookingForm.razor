@rendermode InteractiveServer
@using Midterm.Models
@using Midterm.Services
@inject BookingState Trips

<div class="rounded-xl bg-ink p-6 text-ivory [color-scheme:dark]">
    @if (phase == Phase.Success && confirmed is not null)
    {
        <div class="bk-pop text-center" role="status">
            <svg class="mx-auto h-16 w-16" viewBox="0 0 52 52" aria-hidden="true">
                <circle cx="26" cy="26" r="24" fill="none" stroke="#c9a227" stroke-width="2" />
                <path class="bk-check-path" fill="none" stroke="#c9a227" stroke-width="4"
                      stroke-linecap="round" stroke-linejoin="round" d="M14 27l8 8 16-17" />
            </svg>
            <p class="bk-sparkle mx-auto mt-2 inline-block text-2xl text-gold" aria-hidden="true">✦</p>
            <h2 @ref="successHeading" tabindex="-1" class="font-display mt-2 text-2xl outline-none">You're going to @Package.Title!</h2>
            <p class="mt-2 text-sm text-[#faf7f1]/70">
                Reference <span class="font-semibold text-gold">@confirmed.Reference</span> ·
                @confirmed.Guests @(confirmed.Guests == 1 ? "traveler" : "travelers") ·
                @confirmed.TravelDate.ToString("MMM d, yyyy")
            </p>
            <p class="mt-1 text-lg">Total: <span class="font-semibold text-gold">₱@Total.ToString("N0")</span></p>
            <div class="mt-5 flex flex-col gap-2">
                <a href="my-trips"
                   class="bg-gold px-5 py-2.5 text-center text-sm font-semibold uppercase tracking-[0.2em] text-ink transition-transform duration-150 hover:-translate-y-0.5 active:scale-95">
                    View my trips
                </a>
                <button @onclick="Reset"
                        class="px-5 py-2.5 text-center text-xs uppercase tracking-[0.25em] text-[#faf7f1]/60 hover:text-gold">
                    Book another date
                </button>
            </div>
        </div>
    }
    else if (phase == Phase.Sending)
    {
        <div class="py-10 text-center" aria-live="polite">
            <p class="bk-drift inline-block text-4xl">✈</p>
            <p class="mt-3 text-sm uppercase tracking-[0.25em] text-[#faf7f1]/70">Reserving your seats…</p>
        </div>
    }
    else
    {
        <p class="mt-1"><span class="font-display text-3xl">₱@Package.PricePerPerson.ToString("N0")</span> <span class="text-sm text-[#faf7f1]/60">/ person</span></p>

        <EditForm Model="draft" OnValidSubmit="SubmitAsync" class="mt-4 space-y-3">
            <DataAnnotationsValidator />

            <div>
                <label class="mb-1 block text-xs uppercase tracking-[0.2em] text-[#faf7f1]/70" for="bk-name">Full name</label>
                <InputText id="bk-name" @bind-Value="draft.FullName" placeholder="Juan Dela Cruz"
                           class="w-full rounded-lg border border-[#faf7f1]/20 bg-[#faf7f1]/5 px-3 py-2 text-sm text-ivory outline-none placeholder:text-[#faf7f1]/30 focus:border-gold" />
                <ValidationMessage For="() => draft.FullName" class="bk-field-msg mt-1 block text-xs text-[#e08a7d]" />
            </div>

            <div>
                <label class="mb-1 block text-xs uppercase tracking-[0.2em] text-[#faf7f1]/70" for="bk-email">Email</label>
                <InputText id="bk-email" @bind-Value="draft.Email" placeholder="you@example.com"
                           class="w-full rounded-lg border border-[#faf7f1]/20 bg-[#faf7f1]/5 px-3 py-2 text-sm text-ivory outline-none placeholder:text-[#faf7f1]/30 focus:border-gold" />
                <ValidationMessage For="() => draft.Email" class="bk-field-msg mt-1 block text-xs text-[#e08a7d]" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="mb-1 block text-xs uppercase tracking-[0.2em] text-[#faf7f1]/70" for="bk-date">Travel date</label>
                    <InputDate id="bk-date" @bind-Value="draft.TravelDate"
                               class="w-full rounded-lg border border-[#faf7f1]/20 bg-[#faf7f1]/5 px-3 py-2 text-sm text-ivory outline-none focus:border-gold" />
                    <ValidationMessage For="() => draft.TravelDate" class="bk-field-msg mt-1 block text-xs text-[#e08a7d]" />
                </div>
                <div>
                    <label class="mb-1 block text-xs uppercase tracking-[0.2em] text-[#faf7f1]/70" for="bk-guests">Guests</label>
                    <InputNumber id="bk-guests" @bind-Value="draft.Guests"
                                 class="w-full rounded-lg border border-[#faf7f1]/20 bg-[#faf7f1]/5 px-3 py-2 text-sm text-ivory outline-none focus:border-gold" />
                    <ValidationMessage For="() => draft.Guests" class="bk-field-msg mt-1 block text-xs text-[#e08a7d]" />
                </div>
            </div>

            <div>
                <label class="mb-1 block text-xs uppercase tracking-[0.2em] text-[#faf7f1]/70" for="bk-notes">Notes (optional)</label>
                <InputTextArea id="bk-notes" @bind-Value="draft.Notes" rows="2" placeholder="Anniversary trip, vegetarian meals…"
                               class="w-full rounded-lg border border-[#faf7f1]/20 bg-[#faf7f1]/5 px-3 py-2 text-sm text-ivory outline-none placeholder:text-[#faf7f1]/30 focus:border-gold" />
            </div>

            <div class="flex items-center justify-between border-t border-[#faf7f1]/15 pt-3">
                <span class="text-sm text-[#faf7f1]/70">Total</span>
                <span @key="Total" class="bk-pulse font-display text-2xl text-gold">₱@Total.ToString("N0")</span>
            </div>

            <button type="submit"
                    class="w-full bg-gold px-5 py-3 text-sm font-semibold uppercase tracking-[0.2em] text-ink transition-transform duration-150 hover:-translate-y-0.5 active:scale-95">
                Reserve this trip
            </button>
        </EditForm>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public TourPackage Package { get; set; } = default!;

    private Booking draft = new();
    private Booking? confirmed;
    private Phase phase = Phase.Form;
    private ElementReference successHeading;
    private bool needsSuccessFocus;

    private decimal Total => Package.PricePerPerson * draft.Guests;

    protected override void OnParametersSet()
    {
        draft.PackageSlug = Package.Slug;
    }

    private async Task SubmitAsync()
    {
        phase = Phase.Sending;
        await Task.Delay(400);
        draft.PackageSlug = Package.Slug;
        Trips.Add(draft);
        confirmed = draft;
        phase = Phase.Success;
        needsSuccessFocus = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (needsSuccessFocus)
        {
            needsSuccessFocus = false;
            try { await successHeading.FocusAsync(); } catch { }
        }
    }

    private void Reset()
    {
        draft = new() { PackageSlug = Package.Slug };
        confirmed = null;
        phase = Phase.Form;
    }

    private enum Phase { Form, Sending, Success }
}
