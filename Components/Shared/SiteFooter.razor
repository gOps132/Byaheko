@inject NavigationManager Nav
@implements IDisposable
<footer class="bg-[#16130d] text-[#faf7f1]">
    @if (!IsPackagesPage)
    {
        <div class="border-y border-[#c9a227]/30 bg-[#c9a227]">
            <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-4 px-4 py-8 text-[#16130d] md:flex-row md:items-center">
                <p class="font-display text-2xl md:text-3xl">Your islands are waiting.</p>
                <a href="packages"
                   class="bg-[#16130d] px-6 py-3 text-sm uppercase tracking-[0.2em] text-[#faf7f1] transition-transform duration-150 hover:-translate-y-0.5 active:scale-95">
                    Browse Packages
                </a>
            </div>
        </div>
    }

    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 md:grid-cols-3">
        <div>
            <p class="font-display text-xl">Biyahe<span class="text-[#c9a227]">Ko</span></p>
            <p class="mt-1 text-[11px] uppercase tracking-[0.3em] text-[#8a8272]">Travel &amp; Tours</p>
            <p class="mt-3 max-w-xs text-sm text-[#faf7f1]/70">Discover the Philippines in style. Island escapes, heritage trails, and honest local guidance.</p>
        </div>
        <div>
            <p class="text-sm uppercase tracking-[0.2em] text-[#c9a227]">Explore</p>
            <ul class="mt-3 space-y-2 text-sm text-[#faf7f1]/80">
                <li><a class="hover:text-[#c9a227]" href="">Home</a></li>
                <li><a class="hover:text-[#c9a227]" href="packages">Packages</a></li>
                <li><a class="hover:text-[#c9a227]" href="my-trips">My Trips</a></li>
                <li><a class="hover:text-[#c9a227]" href="about">About</a></li>
            </ul>
        </div>
        <div>
            <p class="text-sm uppercase tracking-[0.2em] text-[#c9a227]">Contact</p>
            <ul class="mt-3 space-y-2 text-sm text-[#faf7f1]/80">
                <li>hello@biyaheko.ph</li>
                <li>+63 (2) 8555 0134</li>
                <li>Makati City, Metro Manila</li>
            </ul>
        </div>
    </div>

    <p class="border-t border-[#faf7f1]/10 py-4 text-center text-xs text-[#8a8272]">
        © 2026 BiyaheKo Travel &amp; Tours. Model site for demonstration.
    </p>
</footer>

@code {
    private bool IsPackagesPage => Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/').StartsWith("packages", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
