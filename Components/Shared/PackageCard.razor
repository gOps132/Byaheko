@using Midterm.Models
<a href="@($"packages/{Package.Slug}")"
   class="group block overflow-hidden rounded-xl border border-[#16130d]/10 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
    <div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-[#16130d] via-[#3a2f18] to-[#c9a227]">
        <img src="@Package.ImageUrl" alt="@Package.Title, @Package.Destination"
             loading="lazy"
             class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <span class="absolute left-3 top-3 bg-[#16130d]/85 px-3 py-1 text-xs uppercase tracking-[0.2em] text-[#faf7f1]">
            @Package.DurationLabel
        </span>
        <span class="absolute right-3 top-3 bg-[#c9a227] px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-[#16130d]">
            @Package.Category
        </span>
    </div>
    <div class="p-5">
        <p class="text-xs uppercase tracking-[0.25em] text-[#8a8272]">@Package.Destination</p>
        <h3 class="font-display mt-1 text-xl leading-snug">@Package.Title</h3>
        <p class="mt-1 text-sm italic text-[#8a8272]">@Package.DreamLine</p>
        <div class="mt-4 flex items-center justify-between border-t border-[#16130d]/10 pt-3">
            <span class="text-sm text-[#8a8272]">
                <span class="text-lg font-semibold text-[#16130d]">₱@Package.PricePerPerson.ToString("N0")</span>
                / person
            </span>
            <RatingStars Rating="Package.Rating" />
        </div>
    </div>
</a>

@code {
    [Parameter, EditorRequired]
    public TourPackage Package { get; set; } = default!;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? ExtraAttributes { get; set; }
}
