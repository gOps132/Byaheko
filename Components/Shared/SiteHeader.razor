@rendermode InteractiveServer
<header class="sticky top-0 z-50 border-b border-[#c9a227]/25 bg-[#16130d]/95 text-ivory backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href="/" class="leading-tight">
            <span class="font-display block text-2xl tracking-wide">Biyahe<span class="text-gold">Ko</span></span>
        </a>

        <button @onclick="ToggleMenu" aria-label="Toggle navigation" aria-expanded="@menuOpen" aria-controls="mobile-nav"
                class="flex min-h-11 min-w-11 items-center justify-center rounded border border-[#c9a227]/40 px-3 py-1 text-xl leading-none md:hidden">
            @(menuOpen ? "×" : "☰")
        </button>

        <nav class="hidden items-center gap-8 text-sm uppercase tracking-[0.2em] md:flex">
            <NavLink href="" Match="NavLinkMatch.All" ActiveClass="!text-gold !border-gold"
                     class="border-b-2 border-transparent pb-1 text-[#faf7f1]/80 transition-colors hover:text-gold">
                Home
            </NavLink>
            <NavLink href="packages" ActiveClass="!text-gold !border-gold"
                     class="border-b-2 border-transparent pb-1 text-[#faf7f1]/80 transition-colors hover:text-gold">
                Packages
            </NavLink>
            <NavLink href="my-trips" ActiveClass="!text-gold !border-gold"
                     class="border-b-2 border-transparent pb-1 text-[#faf7f1]/80 transition-colors hover:text-gold">
                My Trips
            </NavLink>
            <NavLink href="about" ActiveClass="!text-gold !border-gold"
                     class="border-b-2 border-transparent pb-1 text-[#faf7f1]/80 transition-colors hover:text-gold">
                About
            </NavLink>
            <a href="packages"
               class="bg-gold px-5 py-2 text-ink transition-transform duration-150 hover:-translate-y-0.5 active:scale-95">
                Book Now
            </a>
        </nav>
    </div>

    @if (menuOpen)
    {
        <nav id="mobile-nav" class="flex flex-col gap-1 border-t border-[#c9a227]/25 px-4 py-3 text-sm uppercase tracking-[0.2em] md:hidden">
            <NavLink href="" Match="NavLinkMatch.All" ActiveClass="!text-gold"
                     class="py-3 text-[#faf7f1]/80" @onclick="CloseMenu">Home</NavLink>
            <NavLink href="packages" ActiveClass="!text-gold"
                     class="py-3 text-[#faf7f1]/80" @onclick="CloseMenu">Packages</NavLink>
            <NavLink href="my-trips" ActiveClass="!text-gold"
                     class="py-3 text-[#faf7f1]/80" @onclick="CloseMenu">My Trips</NavLink>
            <NavLink href="about" ActiveClass="!text-gold"
                     class="py-3 text-[#faf7f1]/80" @onclick="CloseMenu">About</NavLink>
        </nav>
    }
</header>

@code {
    private bool menuOpen;

    private void ToggleMenu() => menuOpen = !menuOpen;

    private void CloseMenu() => menuOpen = false;
}
