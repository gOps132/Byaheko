<span class="inline-flex items-center gap-1 text-sm" role="img" aria-label="Rated @Rating.ToString("0.0") out of 5 stars">
    <span class="text-gold" aria-hidden="true">★</span>
    <span class="font-medium">@Rating.ToString("0.0")</span>
</span>

@code {
    [Parameter]
    public double Rating { get; set; }
}
