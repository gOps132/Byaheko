<div class="rounded-xl border border-dashed border-[#c9a227]/50 bg-[#c9a227]/5 px-6 py-14 text-center">
    <p class="font-display text-2xl">@Title</p>
    <p class="mx-auto mt-2 max-w-md text-sm text-[#6b6455]">@Message</p>
    @if (ChildContent is not null)
    {
        <div class="mt-5">@ChildContent</div>
    }
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "Nothing here yet";

    [Parameter]
    public string Message { get; set; } = "";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
